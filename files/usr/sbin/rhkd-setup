#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
# rhkd-setup -- HomeKit pairing helper for rhkd
#
#   rhkd-setup status     JSON: running, paired, controller count, name, setup code and payload
#   rhkd-setup unpair     forget all controllers (keeps the setup code); the camera can be added again
#   rhkd-setup newcode    new setup code and setup ID (also unpairs)
#   rhkd-setup provision  create a store with a new setup code if there is none (used by install/boot)
#   rhkd-setup codecs     JSON: camera codecs and whether HomeKit can use them (H.264 video, Opus audio)
#   rhkd-setup fixcodecs  make them HomeKit-compatible: audio -> opus; if neither stream is H.264, sub -> h264.
#                         Applied live and saved to raptor.conf; the RTSP server restarts so clients re-read SDP.
#
# Store layout (HomeKitADK POSIX key-value store, files named <domain>.<key> in hex):
#   40.10 SRP salt (16) + verifier (384)   40.11 setup ID + NUL   -> setup code material, kept by unpair
#   90.xx device ID, long-term keys, configuration number         -> regenerated by rhkd after unpair
#   A0.xx controller pairings                                      -> removed by unpair
#   00.xx rhkd app state (database revision)

DEFAULTS=/etc/default/rhkd
RHKD_STORE=/etc/homekit/store
RHKD_NAME=
# shellcheck disable=SC1090
[ -f "$DEFAULTS" ] && . "$DEFAULTS"
SETUP_TXT=$(dirname "$RHKD_STORE")/setup.txt
INIT=/etc/init.d/S98rhkd
CATEGORY=17 # IP camera

json_str() { printf '"%s"' "$(printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g')"; }

line() { sed -n "${1}p" "$SETUP_TXT" 2>/dev/null | tr -d '\r\n'; }

status() {
	pid=$(pidof rhkd)
	paired=false
	count=$(ls "$RHKD_STORE"/A0.* 2>/dev/null | wc -l)
	[ "$count" -gt 0 ] && paired=true
	sf=$(sed -n 's/^txt sf=//p' /run/hap.service 2>/dev/null)
	cn=$(sed -n 's/^txt c#=//p' /run/hap.service 2>/dev/null)
	name=$(sed -n 's/^name //p' /run/hap.service 2>/dev/null)
	[ -n "$name" ] || name=${RHKD_NAME:-$(hostname)}
	printf '{"running":%s,"pid":%s,"paired":%s,"controllers":%s,"discoverable":%s,"name":%s,"config_number":%s,' \
		"$([ -n "$pid" ] && echo true || echo false)" "${pid:-null}" "$paired" "$count" \
		"$([ "$sf" = 1 ] && echo true || echo false)" "$(json_str "$name")" "${cn:-null}"
	printf '"setup_code":%s,"setup_payload":%s,"setup_id":%s,"category":%s,"version":%s,"codecs":%s}\n' \
		"$(json_str "$(line 2)")" "$(json_str "$(line 6)")" "$(json_str "$(line 5)")" "$CATEGORY" \
		"$(json_str "$(rhkd --version 2>/dev/null | head -n 1)")" "$(codecs)"
}

# Codec of video channel $1 (0 main, 1 sub) from rvd status: h264, h265, or empty.
video_codec() {
	c=$(raptorctl rvd status 2>/dev/null | grep -o "\"chn\":$1,[^}]*" | sed -n 's/.*"codec":\([0-9]*\).*/\1/p')
	case "$c" in 0) echo h264 ;; 1) echo h265 ;; '') ;; *) echo "codec$c" ;; esac
}

audio_codec() { raptorctl rad status 2>/dev/null | sed -n 's/.*"codec":"\([a-z0-9]*\)".*/\1/p'; }

codecs() {
	a=$(audio_codec)
	m=$(video_codec 0)
	s=$(video_codec 1)
	vok=false
	{ [ "$m" = h264 ] || [ "$s" = h264 ]; } && vok=true
	printf '{"audio":%s,"main":%s,"sub":%s,"video_ok":%s,"audio_ok":%s}' "$(json_str "$a")" "$(json_str "$m")" \
		"$(json_str "$s")" "$vok" "$([ "$a" = opus ] && echo true || echo false)"
}

fixcodecs() {
	changed=
	if [ "$(audio_codec)" != opus ]; then
		raptorctl rad set-codec opus >/dev/null && raptorctl config set audio codec opus >/dev/null || return 1
		logger -t rhkd-setup "audio codec set to opus for HomeKit"
		changed=1
	fi
	if [ "$(video_codec 0)" != h264 ] && [ "$(video_codec 1)" != h264 ]; then
		raptorctl rvd set-codec 1 h264 >/dev/null && raptorctl config set stream1 codec h264 >/dev/null || return 1
		# A full rvd restart, not "rvd stream-restart 1": after a live H.265 -> H.264 switch the restarted channel kept
		# failing (publish_iov -28 on every keyframe, ">8 unique encoder buffers") until rvd was restarted.
		raptorctl rvd restart >/dev/null
		sleep 8
		logger -t rhkd-setup "sub stream codec set to h264 for HomeKit"
		changed=1
	fi
	if [ -n "$changed" ]; then
		# "config set" already wrote raptor.conf; no "config save", which would also persist unrelated live changes.
		raptorctl rsd restart >/dev/null # RTSP clients reconnect and see the new codecs
		sleep 2
	fi
	codecs
	echo
}

stop_rhkd() { [ -x "$INIT" ] && "$INIT" stop >/dev/null 2>&1; }
start_rhkd() { [ -x "$INIT" ] && "$INIT" start >/dev/null 2>&1; }

forget_pairing() {
	rm -f "$RHKD_STORE"/A0.* "$RHKD_STORE"/90.*
}

write_code() {
	command -v hap-setupgen >/dev/null || { echo "hap-setupgen not installed" >&2; return 1; }
	tmp=$SETUP_TXT.new
	umask 077
	hap-setupgen --ip --category "$CATEGORY" >"$tmp" || { rm -f "$tmp"; return 1; }
	salt=$(sed -n 3p "$tmp")
	verifier=$(sed -n 4p "$tmp")
	setup_id=$(sed -n 5p "$tmp")
	if [ ${#salt} -ne 32 ] || [ ${#verifier} -ne 768 ] || [ ${#setup_id} -ne 4 ]; then
		echo "unexpected hap-setupgen output" >&2
		rm -f "$tmp"
		return 1
	fi
	mkdir -p "$RHKD_STORE"
	chmod 700 "$(dirname "$RHKD_STORE")" "$RHKD_STORE"
	printf '%s%s' "$salt" "$verifier" | xxd -r -p >"$RHKD_STORE/40.10"
	{ printf '%s' "$setup_id"; printf '\000'; } >"$RHKD_STORE/40.11"
	mv "$tmp" "$SETUP_TXT"
	chmod 600 "$SETUP_TXT"
}

case "$1" in
	status) status ;;
	unpair)
		stop_rhkd
		forget_pairing
		start_rhkd
		logger -t rhkd-setup "pairings removed"
		status
		;;
	newcode)
		stop_rhkd
		forget_pairing
		write_code || { start_rhkd; exit 1; }
		start_rhkd
		logger -t rhkd-setup "new setup code generated"
		status
		;;
	codecs) codecs; echo ;;
	fixcodecs) fixcodecs || { echo "fixcodecs failed" >&2; exit 1; } ;;
	provision)
		if [ -f "$RHKD_STORE/40.10" ] && [ -f "$SETUP_TXT" ]; then
			echo "store already provisioned"
		else
			write_code && echo "provisioned $RHKD_STORE"
		fi
		;;
	*)
		echo "Usage: $0 {status|unpair|newcode|provision|codecs|fixcodecs}" >&2
		exit 1
		;;
esac
